# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채운다. .env.local 은 커밋되지 않는다.
# 값은 절대 이 파일에 적지 마라.

# data.go.kr 공공데이터포털 서비스키 (서버 전용).
# 발급: https://www.data.go.kr → 마이페이지 → 개발계정 → 일반 인증키
# 반드시 **Encoding** 형태(%2F, %2B, %3D 가 이미 들어 있는 쪽)를 넣어라.
# Decoding 키를 넣으면 lib/datago.ts 가 한 번 더 인코딩하지만, 두 키를 섞으면
# SERVICE_KEY_IS_NOT_REGISTERED_ERROR 가 난다.
# 쓰는 곳: app/api/mountain-weather, app/api/danger (lib/datago.ts)
DATA_GO_KR_KEY=

# 브이월드 2D 지도 API 키 (클라이언트 노출됨 — 설계상 정상).
# 발급: https://www.vworld.kr → 오픈API → 인증키 발급
# 발급 시 등록한 도메인에만 동작한다(Referer 검사). 로컬은 localhost,
# 배포는 korea-mountain.vercel.app 을 각각 등록해야 한다.
# 비워 두면 브이월드 배경지도 버튼만 잠기고 나머지는 정상 동작한다.
NEXT_PUBLIC_VWORLD_KEY=
